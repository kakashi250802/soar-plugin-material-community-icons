/** Plugin icon face; font is provided by the installed plugin. */
export function MaterialCommunityIcon({ name, size = 12, color = "#000000", style, accessibilityLabel, accessibilityRole }: {
  name: string; size?: number; color?: string; style?: Style; accessibilityLabel?: string;
  accessibilityRole?: "none" | "button" | "text" | "header" | "image" | "link" | "checkbox" | "radio" | "progressbar";
}) {
  const glyph = name == "" ? "" : format.lookupStringTable(table, name, "?");
  return <Text fontSize={size} color={color} accessibilityLabel={accessibilityLabel} accessibilityRole={accessibilityRole} style={[style, { fontFamily: "soar-plugin-assets/material-community-icons/assets/MaterialCommunityIcons.ttf", fontWeight: 400 }]}>{glyph}</Text>;
}
